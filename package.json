{
  "name": "mcp-vision-server",
  "version": "0.1.4",
  "private": false,
  "description": "MCP stdio server for image recognition via an existing vision model",
  "license": "MIT",
  "author": "ANYU",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "mcp-vision-server": "dist/server.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goehou/mcp-vision-server.git"
  },
  "homepage": "https://github.com/goehou/mcp-vision-server#readme",
  "bugs": {
    "url": "https://github.com/goehou/mcp-vision-server/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vision",
    "ocr",
    "multimodal"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:build": "npm run build && node --test --experimental-test-isolation=none \"dist/**/*.test.js\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepublishOnly": "npm run lint && npm run test:build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2"
  }
}
